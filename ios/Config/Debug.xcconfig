// Debug builds install beside the App Store app, as the desktop's debug
// builds do (scripts/build-debug.sh).

#include "Base.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = app.capyvibe.leaflet.debug
INFOPLIST_KEY_CFBundleDisplayName = Leaflet Debug

// Info.plist's words in each language, the name above among them, from
// Resources/Debug; Release's, which leave the name as it is, stay out.
EXCLUDED_SOURCE_FILE_NAMES = */Resources/Release/InfoPlist.xcstrings
